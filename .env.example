# --- server ---------------------------------------------------------------
PORT=8787
# Public base URL this process is reachable at (used to build the Twilio
# <Stream> wss:// URL). In dev this is your tunnel URL, e.g. an ngrok host.
PUBLIC_BASE_URL=http://localhost:8787

# --- Deepgram Voice Agent ---------------------------------------------------
DEEPGRAM_API_KEY=
DEEPGRAM_THINK_PROVIDER=open_ai
DEEPGRAM_THINK_MODEL=gpt-4o-mini
DEEPGRAM_LISTEN_MODEL=flux-general-en
DEEPGRAM_SPEAK_MODEL=aura-2-thalia-en
# 8s per https://developers.deepgram.com/docs/agent-keep-alive
DEEPGRAM_KEEPALIVE_INTERVAL_MS=8000

# --- Keevaris (unit-hq-api) Vocal Bridge delegation endpoint ---------------
# POST {KEEVARIS_API_URL}/api/voice/bridge/{bridgeToken} — one entry per
# inbound number. Credentials stay local: VoiceBridgeAuth needs the secret
# already, so this set cannot be fetched from the API at call time.
KEEVARIS_API_URL=http://localhost:8000
# VOICE_BRIDGE_NUMBERS=[{"phoneNumber":"+15555550100","bridgeToken":"tok_a","bridgeSecret":"sec_a"}]
KEEVARIS_BRIDGE_TIMEOUT_MS=12000

# --- Twilio ------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Set to "false" locally if you are not fronting this with a real Twilio
# number yet and want to skip webhook signature validation.
TWILIO_VALIDATE_SIGNATURE=true

# --- transfer destinations --------------------------------------------------
# Phone numbers the transport dials when the backend asks for a transfer.
TRANSFER_MAIN_LINE_NUMBER=
TRANSFER_VOICEMAIL_NUMBER=

# Placeholder until the greeting is served from unit-hq-api's
# VoiceBridgeCustomerConfig with the operator's real registered name.
COMPANY_NAME=Keevaris

# --- connection auth (V01-01) ---------------------------------------------
# Set to true locally to serve public/dev.html and GET /dev/token.
# /dev/token mints against the first VOICE_BRIDGE_NUMBERS entry — a
# placeholder until V08 wires a real per-number mint, not a considered default.
ALLOW_DEV_PAGE=false
# Shared secret for signed /web/media tokens. Will eventually be shared with
# the unit-hq-api minter endpoint (V08).
WEB_TOKEN_SECRET=
# Web token lifetime in milliseconds (default 5 minutes).
WEB_TOKEN_TTL_MS=300000
# Single-use Twilio nonce lifetime in milliseconds (default 60 seconds).
CALL_REGISTRY_TTL_MS=60000
# Maximum concurrent WebSocket sessions accepted at upgrade.
MAX_CONCURRENT_SESSIONS=20
# Hard cap on a single call, from VoiceSession.start (default 30 minutes).
MAX_CALL_SECONDS=1800
# Hang up after this many seconds with no caller audio and no agent audio.
IDLE_TIMEOUT_SECONDS=300
# Armed-transfer safety net. ChannelProfile::Voice is 600 chars / 2 sentences;
# ~150 wpm neural TTS is ~40s for that ceiling, plus a small margin.
TRANSFER_ARM_DEADLINE_MS=45000

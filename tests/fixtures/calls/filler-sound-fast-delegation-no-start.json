{
  "name": "filler-sound-fast-delegation-no-start",
  "note": "ask() resolves before the spoken filler's AgentAudioDone. The typing clip must never start (only the scripted answer frame is sent) and transfer still waits for the answer's AgentAudioDone.",
  "delegation": {
    "response": {
      "text": "I am transferring you to the front desk.",
      "transfer": true,
      "destination": "main_line"
    }
  },
  "events": [
    { "at": 0, "from": "agentSocket", "kind": "open" },
    { "at": 1, "from": "agentSocket", "kind": "control", "message": { "type": "Welcome", "request_id": "req_1" } },
    { "at": 2, "from": "agentSocket", "kind": "control", "message": { "type": "SettingsApplied" } },
    {
      "at": 100,
      "from": "agentSocket",
      "kind": "control",
      "message": {
        "type": "FunctionCallRequest",
        "functions": [
          {
            "id": "fc_1",
            "name": "ask_keevaris",
            "arguments": "{\"query\":\"can I speak to someone?\"}",
            "client_side": true
          }
        ]
      }
    },
    { "at": 200, "from": "agentSocket", "kind": "control", "message": { "type": "AgentAudioDone" } },
    { "at": 300, "from": "agentSocket", "kind": "audio", "bytes": 320 },
    { "at": 400, "from": "agentSocket", "kind": "control", "message": { "type": "AgentAudioDone" } }
  ],
  "expect": [
    { "on": "transport", "kind": "sendAudio" },
    { "on": "transport", "kind": "transfer" }
  ],
  "forbid": [
    { "on": "transport", "kind": "transfer", "before": 0 }
  ],
  "count": [
    { "on": "transport", "kind": "sendAudio", "exactly": 1 },
    { "on": "transport", "kind": "transfer", "exactly": 1 }
  ]
}

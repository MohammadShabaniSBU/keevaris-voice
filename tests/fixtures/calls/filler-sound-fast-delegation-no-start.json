{
  "name": "filler-sound-fast-delegation-holds-then-answers",
  "note": "ask() resolves before the spoken filler's AgentAudioDone. The typing clip (160-byte mulaw frames) must start after that done, play for FILLER_SOUND_MIN_MS (800), then the answer is injected. Transfer still waits for the answer's AgentAudioDone.",
  "delegation": {
    "response": {
      "text": "I am transferring you to the front desk.",
      "transfer": true,
      "destination": "main_line"
    }
  },
  "events": [
    { "at": 0, "from": "agentSocket", "kind": "open" },
    { "at": 1, "from": "agentSocket", "kind": "control", "message": { "type": "Welcome", "request_id": "req_1" } },
    { "at": 2, "from": "agentSocket", "kind": "control", "message": { "type": "SettingsApplied" } },
    {
      "at": 100,
      "from": "agentSocket",
      "kind": "control",
      "message": {
        "type": "FunctionCallRequest",
        "functions": [
          {
            "id": "fc_1",
            "name": "ask_keevaris",
            "arguments": "{\"query\":\"can I speak to someone?\"}",
            "client_side": true
          }
        ]
      }
    },
    { "at": 200, "from": "agentSocket", "kind": "control", "message": { "type": "AgentAudioDone" } },
    { "at": 280, "from": "clock", "kind": "advance" },
    { "at": 1000, "from": "clock", "kind": "advance" },
    { "at": 1100, "from": "agentSocket", "kind": "audio", "bytes": 320 },
    { "at": 1200, "from": "agentSocket", "kind": "control", "message": { "type": "AgentAudioDone" } }
  ],
  "expect": [
    { "on": "agentSocket", "kind": "send", "messageType": "InjectAgentMessage", "content": "Let me check that for you." },
    { "on": "transport", "kind": "sendAudio", "bytes": 160 },
    { "on": "agentSocket", "kind": "send", "messageType": "InjectAgentMessage", "content": "I am transferring you to the front desk." },
    { "on": "transport", "kind": "sendAudio", "bytes": 320 },
    { "on": "transport", "kind": "transfer" }
  ],
  "forbid": [
    { "on": "agentSocket", "kind": "send", "messageType": "InjectAgentMessage", "content": "I am transferring you to the front desk.", "before": 1 },
    { "on": "transport", "kind": "transfer", "before": 3 }
  ]
}

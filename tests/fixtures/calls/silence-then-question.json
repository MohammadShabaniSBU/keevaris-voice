{
  "name": "silence-then-question",
  "vendor": "web",
  "callerNumber": null,
  "note": "Three minutes of silence must stay connected: KeepAlive is sent on Deepgram's 8s interval (22 ticks from socket open at t=0 through t=180000, last fire at 176000). A question after the silence is still answered. Uses the asymmetric web AudioFormat (linear16 16 kHz in / 24 kHz out) that V01-03 will derive its buffer cap from.",
  "audio": {
    "input": { "encoding": "linear16", "sampleRate": 16000 },
    "output": { "encoding": "linear16", "sampleRate": 24000 }
  },
  "delegation": {
    "response": {
      "text": "A 10 by 10 is 89 a month.",
      "transfer": false
    }
  },
  "events": [

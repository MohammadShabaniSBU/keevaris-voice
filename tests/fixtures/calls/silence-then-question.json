      "message": {
        "type": "FunctionCallRequest",
        "functions": [
          {
            "id": "fc_1",
            "name": "ask_keevaris",
            "arguments": "{\"query\":\"how much is a 10 by 10?\"}",
            "client_side": true
          }
        ]
      }
    },
    { "at": 180100, "from": "agentSocket", "kind": "audio", "bytes": 480 },
    { "at": 180200, "from": "agentSocket", "kind": "control", "message": { "type": "AgentAudioDone" } }
  ],
  "expect": [
    { "on": "agentSocket", "kind": "send", "messageType": "FunctionCallResponse" },
    { "on": "transport", "kind": "sendAudio" }

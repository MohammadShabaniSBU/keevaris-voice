{
  "name": "bridge-config-drives-greeting-and-prompt",
  "note": "V03-03. A non-default BridgeConfig drives Settings.greeting, Settings.think.prompt, and the filler InjectAgentMessage — not the old hardcoded English.",
  "bridgeConfig": {
    "response": {
      "companyName": "Almacenajes Sur",
      "locale": "es",
      "greeting": "Soy un asistente automatizado de Almacenajes Sur.",
      "filler": "Un momento, lo consulto.",
      "promptAdditions": [
        "Never invent a site name.",
        "Always mention the site city when asked."
      ],
      "transfer": {
        "mainLineNumber": "+34911000000",
        "voicemailNumber": "+34911000001"
      },
      "maxCallDurationMinutes": 30
    }
  },
  "delegation": {
    "response": {
      "text": "Tenemos unidades disponibles.",
      "transfer": false
    }
  },
  "events": [
    { "at": 0, "from": "agentSocket", "kind": "open" },
    { "at": 1, "from": "agentSocket", "kind": "control", "message": { "type": "Welcome", "request_id": "req_1" } },
    { "at": 2, "from": "agentSocket", "kind": "control", "message": { "type": "SettingsApplied" } },
    {
      "at": 100,
      "from": "agentSocket",
      "kind": "control",
      "message": {
        "type": "FunctionCallRequest",
        "functions": [
          {
            "id": "fc_1",
            "name": "ask_keevaris",
            "arguments": "{\"query\":\"tienen unidades?\"}",
            "client_side": true
          }
        ]
      }
    },
    { "at": 200, "from": "agentSocket", "kind": "audio", "bytes": 320 },
    { "at": 300, "from": "agentSocket", "kind": "control", "message": { "type": "AgentAudioDone" } }
  ],
  "expect": [
    {
      "on": "agentSocket",
      "kind": "send",
      "messageType": "Settings",
      "greeting": "Soy un asistente automatizado de Almacenajes Sur.",
      "prompt": "The opening disclosure line has already been spoken to the caller before you receive any input. Do not repeat it, and do not say anything before the caller speaks.\nAnswer in the language the caller is speaking, even if it differs from the opening line's language.\nNever invent a site name.\nAlways mention the site city when asked."
    },
    { "on": "agentSocket", "kind": "send", "messageType": "InjectAgentMessage", "content": "Un momento, lo consulto." },
    { "on": "agentSocket", "kind": "send", "messageType": "InjectAgentMessage", "content": "Tenemos unidades disponibles." },
    { "on": "transport", "kind": "sendAudio" }
  ],
  "forbidContent": [
    {
      "on": "agentSocket",
      "kind": "send",
      "messageType": "Settings",
      "notContaining": ["I am an automated assistant for"]
    }
  ]
}

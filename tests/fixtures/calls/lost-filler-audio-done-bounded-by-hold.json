{
  "name": "lost-filler-audio-done-bounded-by-hold",
  "note": "V5 + V7. Filler is injected and the answer is ready, but AgentAudioDone never arrives. After FILLER_ANSWER_HOLD_MAX_MS the session skips the filler wait and still injects the answer.",
  "delegation": {
    "delayMs": 200,
    "response": {
      "text": "We are open from 8am to 6pm.",
      "transfer": false
    }
  },
  "events": [
    { "at": 0, "from": "agentSocket", "kind": "open" },
    { "at": 1, "from": "agentSocket", "kind": "control", "message": { "type": "Welcome", "request_id": "req_1" } },
    { "at": 2, "from": "agentSocket", "kind": "control", "message": { "type": "SettingsApplied" } },
    {
      "at": 100,
      "from": "agentSocket",
      "kind": "control",
      "message": {
        "type": "FunctionCallRequest",
        "functions": [
          {
            "id": "fc_1",
            "name": "ask_keevaris",
            "arguments": "{\"query\":\"what are your hours?\"}",
            "client_side": true
          }
        ]
      }
    },
    { "at": 400, "from": "clock", "kind": "advance" },
    { "at": 3400, "from": "clock", "kind": "advance" },
    { "at": 3500, "from": "caller", "kind": "close", "reason": "caller_hangup" }
  ],
  "expect": [
    { "on": "agentSocket", "kind": "send", "messageType": "InjectAgentMessage", "behavior": "interrupt", "content": "Let me check that for you." },
    { "on": "session", "kind": "session.filler_answer_hold_expired" },
    { "on": "agentSocket", "kind": "send", "messageType": "InjectAgentMessage", "behavior": "interrupt", "content": "We are open from 8am to 6pm." },
    { "on": "agentSocket", "kind": "send", "messageType": "FunctionCallResponse" }
  ],
  "count": [
    { "on": "session", "kind": "session.filler_sound_started", "exactly": 0 },
    { "on": "session", "kind": "session.filler_answer_hold_expired", "exactly": 1 },
    { "on": "agentSocket", "kind": "send", "messageType": "FunctionCallResponse", "exactly": 1 }
  ]
}

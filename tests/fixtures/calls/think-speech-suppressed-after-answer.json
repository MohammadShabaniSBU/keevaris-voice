{
  "name": "think-speech-suppressed-after-answer",
  "note": "V5 + V7. After the delegated answer's AgentAudioDone, a leftover think-model ConversationText and a uniquely sized audio frame must not reach the transport or the transcript. Without suppressThinkSpeech the 99-byte sendAudio and the invented 85-euro line would appear.",
  "delegation": {
    "delayMs": 80,
    "response": {
      "text": "For 20 boxes the size guide suggests 12 to 16 m². A good starting point is the Trastero 12 m² at €183.92 per month all-in.",
      "transfer": false
    }
  },
  "events": [
    { "at": 0, "from": "agentSocket", "kind": "open" },
    { "at": 1, "from": "agentSocket", "kind": "control", "message": { "type": "Welcome", "request_id": "req_1" } },
    { "at": 2, "from": "agentSocket", "kind": "control", "message": { "type": "SettingsApplied" } },
    {
      "at": 50,
      "from": "agentSocket",
      "kind": "control",
      "message": {
        "type": "ConversationText",
        "role": "user",
        "content": "I want to store twenty boxes."
      }
    },
    {
      "at": 100,
      "from": "agentSocket",
      "kind": "control",
      "message": {
        "type": "FunctionCallRequest",
        "functions": [
          {
            "id": "fc_1",
            "name": "ask_keevaris",
            "arguments": "{\"query\":\"I want to store twenty boxes.\"}",
            "client_side": true
          }
        ]
      }
    },
    {
      "at": 150,
      "from": "agentSocket",
      "kind": "control",
      "message": {
        "type": "ConversationText",
        "role": "assistant",
        "content": "Let me check that for you."
      }
    },
    { "at": 200, "from": "agentSocket", "kind": "audio", "bytes": 320 },
    { "at": 300, "from": "agentSocket", "kind": "control", "message": { "type": "AgentAudioDone" } },
    { "at": 1100, "from": "clock", "kind": "advance" },
    { "at": 1150, "from": "agentSocket", "kind": "audio", "bytes": 320 },
    { "at": 1200, "from": "agentSocket", "kind": "control", "message": { "type": "AgentAudioDone" } },
    {
      "at": 1300,
      "from": "agentSocket",
      "kind": "control",
      "message": {
        "type": "ConversationText",
        "role": "assistant",
        "content": "For twenty boxes, a 5 m² unit would be perfect. The current monthly rate is 85 euros."
      }
    },
    { "at": 1350, "from": "agentSocket", "kind": "audio", "bytes": 99 },
    { "at": 1400, "from": "caller", "kind": "close", "reason": "caller_hangup" }
  ],
  "expect": [
    { "on": "agentSocket", "kind": "send", "messageType": "InjectAgentMessage", "content": "For 20 boxes the size guide suggests 12 to 16 m². A good starting point is the Trastero 12 m² at €183.92 per month all-in." },
    { "on": "transport", "kind": "sendAudio", "bytes": 320 },
    { "on": "session", "kind": "session.think_speech_suppressed" },
    { "on": "transcript", "kind": "segment", "role": "agent", "source": "delegated", "content": "For 20 boxes the size guide suggests 12 to 16 m². A good starting point is the Trastero 12 m² at €183.92 per month all-in." }
  ],
  "forbidContent": [
    {
      "on": "transcript",
      "kind": "segment",
      "notContaining": ["85 euros", "5 m² unit would be perfect"]
    }
  ],
  "count": [
    { "on": "transport", "kind": "sendAudio", "bytes": 99, "exactly": 0 },
    { "on": "transcript", "kind": "segment", "source": "fast_model", "exactly": 1 },
    { "on": "transcript", "kind": "segment", "source": "delegated", "exactly": 1 },
    { "on": "session", "kind": "session.think_speech_suppressed", "exactly": 1 }
  ]
}

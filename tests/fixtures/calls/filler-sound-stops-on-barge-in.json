{
  "name": "filler-sound-stops-on-barge-in",
  "note": "Typing clip starts after the spoken filler's AgentAudioDone. UserStartedSpeaking must stop it; later clock ticks must not grow sendAudio.",
  "delegation": {
    "delayMs": 2000,
    "response": {
      "text": "We are open from 8am to 6pm.",
      "transfer": false
    }
  },
  "events": [
    { "at": 0, "from": "agentSocket", "kind": "open" },
    { "at": 1, "from": "agentSocket", "kind": "control", "message": { "type": "Welcome", "request_id": "req_1" } },
    { "at": 2, "from": "agentSocket", "kind": "control", "message": { "type": "SettingsApplied" } },
    {
      "at": 100,
      "from": "agentSocket",
      "kind": "control",
      "message": {
        "type": "FunctionCallRequest",
        "functions": [
          {
            "id": "fc_1",
            "name": "ask_keevaris",
            "arguments": "{\"query\":\"what are your hours?\"}",
            "client_side": true
          }
        ]
      }
    },
    { "at": 150, "from": "agentSocket", "kind": "audio", "bytes": 320 },
    { "at": 200, "from": "agentSocket", "kind": "control", "message": { "type": "AgentAudioDone" } },
    { "at": 280, "from": "clock", "kind": "advance" },
    { "at": 300, "from": "agentSocket", "kind": "control", "message": { "type": "UserStartedSpeaking" } },
    { "at": 500, "from": "clock", "kind": "advance" },
    { "at": 600, "from": "caller", "kind": "close", "reason": "caller_hangup" }
  ],
  "expect": [
    { "on": "transport", "kind": "sendAudio", "bytes": 160 },
    { "on": "transport", "kind": "clearAudio" }
  ],
  "count": [
    { "on": "transport", "kind": "sendAudio", "exactly": 6 },
    { "on": "transport", "kind": "clearAudio", "exactly": 1 }
  ]
}

{
  "name": "transfer-abandoned-on-caller-hangup",
  "note": "Transfer armed, then the transport closes (caller hangup) before the answer AgentAudioDone. transport.onClose sets transportGone, so teardown skips dispatch. No transport.transfer; session.transfer_abandoned, not session.transfer_teardown.",
  "delegation": {
    "response": {
      "text": "I am transferring you now.",
      "transfer": true,
      "destination": "main_line"
    }
  },
  "events": [
    { "at": 0, "from": "agentSocket", "kind": "open" },
    { "at": 1, "from": "agentSocket", "kind": "control", "message": { "type": "Welcome", "request_id": "req_1" } },
    { "at": 2, "from": "agentSocket", "kind": "control", "message": { "type": "SettingsApplied" } },
    {
      "at": 100,
      "from": "agentSocket",
      "kind": "control",
      "message": {
        "type": "FunctionCallRequest",
        "functions": [
          {
            "id": "fc_1",
            "name": "ask_keevaris",
            "arguments": "{\"query\":\"I want to talk to a person\"}",
            "client_side": true
          }
        ]
      }
    },
    { "at": 150, "from": "caller", "kind": "close", "reason": "caller_hangup" }
  ],
  "expect": [
    { "on": "session", "kind": "session.transfer_abandoned" }
  ],
  "count": [
    { "on": "transport", "kind": "transfer", "exactly": 0 },
    { "on": "session", "kind": "session.transfer_teardown", "exactly": 0 }
  ]
}

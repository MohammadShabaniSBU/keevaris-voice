{
  "name": "armed-transfer-deadline",
  "note": "Armed transfer, no closing AgentAudioDone. Clock advance past TRANSFER_ARM_DEADLINE_MS (45s from arm at t=100) fires the transfer. Timers must not outlive teardown.",
  "delegation": {
    "response": {
      "text": "I am transferring you now.",
      "transfer": true,
      "destination": "main_line"
    }
  },
  "events": [
    { "at": 0, "from": "agentSocket", "kind": "open" },
    { "at": 1, "from": "agentSocket", "kind": "control", "message": { "type": "Welcome", "request_id": "req_1" } },
    { "at": 2, "from": "agentSocket", "kind": "control", "message": { "type": "SettingsApplied" } },
    {
      "at": 100,
      "from": "agentSocket",
      "kind": "control",
      "message": {
        "type": "FunctionCallRequest",
        "functions": [
          {
            "id": "fc_1",
            "name": "ask_keevaris",
            "arguments": "{\"query\":\"I want to talk to a person\"}",
            "client_side": true
          }
        ]
      }
    },
    { "at": 45100, "from": "clock", "kind": "advance" }
  ],
  "expect": [
    { "on": "session", "kind": "session.transfer_deadline" },
    { "on": "transport", "kind": "transfer" }
  ],
  "assertTimersClearAfter": true
}

{
  "name": "turn-id-increments-across-turns",
  "note": "V02-02. Two sequential FunctionCallRequest events in one session: turn_id increments from sess_fixture:1:0 to sess_fixture:2:0. Only one AgentAudioDone is scripted per round on purpose — this fixture isolates the turn counter, which increments on handleFunctionCalls, not on speech-queue events.",
  "delegation": {
    "responses": [
      {
        "text": "We are open from 8am to 6pm.",
        "transfer": false
      },
      {
        "text": "A 10 by 10 is 89 a month.",
        "transfer": false
      }
    ]
  },
  "events": [
    { "at": 0, "from": "agentSocket", "kind": "open" },
    { "at": 1, "from": "agentSocket", "kind": "control", "message": { "type": "Welcome", "request_id": "req_1" } },
    { "at": 2, "from": "agentSocket", "kind": "control", "message": { "type": "SettingsApplied" } },
    {
      "at": 100,
      "from": "agentSocket",
      "kind": "control",
      "message": {
        "type": "FunctionCallRequest",
        "functions": [
          {
            "id": "fc_1",
            "name": "ask_keevaris",
            "arguments": "{\"query\":\"what are your hours?\"}",
            "client_side": true
          }
        ]
      }
    },
    { "at": 200, "from": "agentSocket", "kind": "control", "message": { "type": "AgentAudioDone" } },
    {
      "at": 300,
      "from": "agentSocket",
      "kind": "control",
      "message": {
        "type": "FunctionCallRequest",
        "functions": [
          {
            "id": "fc_2",
            "name": "ask_keevaris",
            "arguments": "{\"query\":\"how much is a 10 by 10?\"}",
            "client_side": true
          }
        ]
      }
    },
    { "at": 400, "from": "agentSocket", "kind": "control", "message": { "type": "AgentAudioDone" } }
  ],
  "expect": [
    { "on": "delegation", "kind": "ask", "turnId": "sess_fixture:1:0" },
    { "on": "delegation", "kind": "ask", "turnId": "sess_fixture:2:0" }
  ],
  "count": [
    { "on": "delegation", "kind": "ask", "exactly": 2 }
  ]
}
